<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Onsite_App</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Onsite_App.styles.css" asp-append-version="true" />
</head>
<body style="margin:0; padding:0; min-height:100vh; width:100vw;
    background:url('/asset/LandingPage.jpg') no-repeat center center;
    background-size:cover; display:flex; flex-direction:column;">

    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm border-bottom mb-3"
             style="background:rgba(255,255,255,0.15); backdrop-filter:blur(8px);">
            <div class="container-fluid">
                <a class="navbar-brand" asp-area="" asp-controller="Home" asp-action="Index"
                       style="color:#800000;">
                    Joshua's Project Portfolio
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse"
                        aria-controls="navbarSupportedContent" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        <li class="nav-item">
                            <a class="nav-link" asp-area="" asp-controller="Home" asp-action="Index"
                               style="color:#800000;">Home</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-area="" asp-controller="Students" asp-action="List"
                               style="color:#800000;">Client</a>
                        </li>
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <main role="main" style="flex:1; display:flex; justify-content:center; align-items:center;">
        @RenderBody()
    </main>

    <footer class="footer text-white"
            style="background:rgba(255,255,255,0.15); backdrop-filter:blur(8px);
        text-align:center; padding:10px 0; border-top:1px solid rgba(255,255,255,0.3);">
        <div class="container">
            &copy; 2026 - Onsite_App -
            <a asp-area="" asp-controller="Home" asp-action="Privacy" class="text-white">Privacy</a>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
