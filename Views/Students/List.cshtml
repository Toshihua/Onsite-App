@{
    ViewData["Title"] = "List";
}
@model List<Onsite_App.Models.Entities.Student>

<!-- Glass-style wrapper for the whole section -->
<div style="background:rgba(255,255,255,0.15);border-radius:12px;padding:20px;
    backdrop-filter:blur(10px);-webkit-backdrop-filter:blur(10px);
    border:1px solid rgba(255,255,255,0.3);box-shadow:0 4px 20px rgba(0,0,0,0.3);
    width:100%; max-width:900px;">

    <!-- Heading + Add button row -->
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h1 class="text-white m-0">Client</h1>
        <a class="btn btn-primary" asp-controller="Students" asp-action="Add">Add Client</a>
    </div>

    <!-- Table -->
    <table class="table table-hover table-striped table-bordered mb-0 text-white">
        <thead style="background:rgba(255,255,255,0.2);">
            <tr>
                <th>Client Name</th>
                <th>Email</th>
                <th>Project Name</th>
                <th style="width:120px;">Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var student in Model)
            {
                <tr>
                    <td>@student.Name</td>
                    <td>@student.Email</td>
                    <td>@student.Project</td>
                    <td>
                        <a class="btn btn-sm btn-secondary"
                               asp-controller="Students"
                               asp-action="Edit"
                               asp-route-id="@student.Id">
                            Edit
                        </a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
